# OpenSearch MCP Agent - Cluster URLs
# Copy this file to .env and fill in your actual cluster URLs.
#
# Format: CLUSTER_<SHORT_NAME>=<URL>
#   - Short name: uppercase, hyphens replaced with underscores
#   - Leave empty or comment out clusters without OpenSearch
#
# Example:
#   CLUSTER_DEV_AWS_EU_CP=https://opensearch-dashboard.dev.example.com

# ── Development ──
CLUSTER_DEV_AWS_EU_CP=
CLUSTER_DEV_AWS_EU_CDP=
# CLUSTER_DEV_AZURE_US_CP=          # No OpenSearch (uses Log Analytics Workspace)
CLUSTER_DEV_AZURE_US_CDP=
CLUSTER_DEV_AZURE_EU_CDP=
CLUSTER_DEV_AZURE_PDP_USERDEV=
CLUSTER_DEV_AZURE_PDP_USERPROD=
CLUSTER_DEV_AWS_PDP=
CLUSTER_DEV_ONPREM_CP=
CLUSTER_DEV_ONPREM_DP=
CLUSTER_DEV_ONPREM_E2E_PDP=

# ── Staging ──
CLUSTER_STG_AWS_EU_CP=
CLUSTER_STG_AWS_EU_CDP=
# CLUSTER_STG_AZURE_US_CP=          # No OpenSearch (uses Log Analytics Workspace)
CLUSTER_STG_AZURE_US_CDP=
CLUSTER_STG_AZURE_EU_CDP=
CLUSTER_STG_AZURE_PDP_USERDEV=
CLUSTER_STG_AZURE_PDP_USERPROD=
CLUSTER_STG_ONPREM_E2E_PDP=

# ── Production ──
CLUSTER_PROD_AWS_EU_CP=
# CLUSTER_PROD_AZURE_US_CP=         # No OpenSearch (uses Log Analytics Workspace)
CLUSTER_PROD_AWS_EU_CDP=
CLUSTER_PROD_AZURE_US_CDP=
CLUSTER_PROD_AZURE_EU_CDP=
CLUSTER_PROD_WDT_USERPROD=
CLUSTER_PROD_WDT_NONPROD_ONPREM=
CLUSTER_PROD_DEVRY=
CLUSTER_PROD_CUTNDRY=
CLUSTER_PROD_BCENTRAL=
